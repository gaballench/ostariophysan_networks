# bootsnaq.sub
# HTCondor submit file for snaq

# Specify your executable (single binary or a script that runs several
#  commands) and arguments to be passed to jobs. 
#  $(Process) will be a integer number for each job, starting with "0"
#  and increasing for the relevant number of jobs.
executable = bootsnaq.sh
arguments = $(Cluster)_$(Process)

# Specify the name of the log, standard error, and standard output (or "screen output") files. Wherever you see $(Cluster), HTCondor will insert the 

log = snaq_$(Cluster)_$(Process).log
error = snaq_$(Cluster)_$(Process).err
output = snaq_$(Cluster)_$(Process).out

# input files for snaq
CFTABLE=CFs_with_CIs_otocephala_wo_steinphracto.csv
TREE=otocephala_bestnet_h4_nosteinphracto_outgroup_clean_prop0.1_logmoves.tre
SNAQ_SCRIPT=bootsnaq_v1.jl

# This lines *would* be used if there were any other files
# needed for the executable to use.
OSDF_LOCATION = osdf:///ospool/ap41/data/balleng/otocephala_subsampled_snaq
transfer_input_files = $(OSDF_LOCATION)/$(CFTABLE), $(OSDF_LOCATION)/$(TREE), $(OSDF_LOCATION)/$(SNAQ_SCRIPT)

# Specify Job duration category as "Medium" (expected runtime <20 hr) or "Long" (expected runtime <40 hr). 
+JobDurationCategory = "Long"

# singularity image with snaq
+SingularityImage = "osdf:///ospool/ap41/data/balleng/programs/snaq_treechildgalled_23_06_2026_16.10.08.sif"

# Tell HTCondor requirements (e.g., operating system) your job needs, 
# what amount of compute resources each job will need on the computer where it runs.
requirements = (Microarch >= "x86_64-v3")
request_cpus = 10
request_memory = 20GB
request_disk = 10GB

#  queue number assigned to this set of jobs at the time of submission.
queue 1000
