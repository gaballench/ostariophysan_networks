# iqtree3.sub
# HTCondor submit file for ufbootstrap using iqtree3

# Specify your executable (single binary or a script that runs several
#  commands) and arguments to be passed to jobs. 
#  $(Process) will be a integer number for each job, starting with "0"
#  and increasing for the relevant number of jobs.
executable = iqtree3.sh
arguments = $(aln)

# Specify the name of the log, standard error, and standard output (or "screen output") files. Wherever you see $(Cluster), HTCondor will insert the 

log = iqtree3_$(Cluster)_$(Process).log
error = iqtree3_$(Cluster)_$(Process).err
output = iqtree3_$(Cluster)_$(Process).out

# This lines *would* be used if there were any other files
# needed for the executable to use.
transfer_input_files = "osdf:///ospool/ap41/data/balleng/otocephala_subsampled_snaq/aligns_wo_steinphracto04_05_2026_06.22.32/$(aln)"

# Specify Job duration category as "Medium" (expected runtime <20 hr) or "Long" (expected runtime <40 hr). 
+JobDurationCategory = "Medium"

# singularity image with mafft
+SingularityImage = "osdf:///ospool/ap41/data/balleng/programs/iqtree3_31_03_2026_14.36.07.sif"

# Tell HTCondor requirements (e.g., operating system) your job needs, 
# what amount of compute resources each job will need on the computer where it runs.
#requirements = (OSGVO_OS_STRING == "RHEL 9")
request_cpus = 10
request_memory = 10GB
request_disk = 10GB

#  queue number assigned to this set of jobs at the time of submission.
queue aln from /ospool/ap41/data/balleng/otocephala_subsampled_snaq/wo_steinphracto_uces_aligned_04_05_2026_06.43.53.txt
